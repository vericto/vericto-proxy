# =============================================================================
# vericto-proxy — LOCAL BUILD Dockerfile
#
# Differs from the production Dockerfile only in how vericto-engine is resolved:
#   - Production (Dockerfile):       git = "https://github.com/.../vericto-engine", tag = "v1.0.0"
#   - Local (this file):             path override via inline sed patch + COPY
#
# Build from the workspace root (so both vericto-proxy/ and vericto-engine/ are
# accessible from the same build context):
#
#   docker build \
#     -f vericto-proxy/Dockerfile.local \
#     -t vericto/proxy:local \
#     --build-context engine=vericto-engine \
#     vericto-proxy/
#
# Or using the helper script: scripts/build-local.sh
# =============================================================================

FROM rust:1.88-slim-bookworm AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libclang-dev \
    clang \
    libssl-dev \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ENV LIBCLANG_PATH=/usr/lib/llvm-14/lib

# Copy vericto-engine source (passed as a named build context: --build-context engine=../vericto-engine)
COPY vericto-engine-local /vericto-engine

# Copy vericto-proxy source.
COPY Cargo.toml ./
COPY src ./src

# Override the git dependency with the local path copy.
RUN sed -i 's|vericto-engine = { git = "https://github.com/donkan168/vericto-engine".*}|vericto-engine = { path = "/vericto-engine" }|' Cargo.toml

# Build.
RUN cargo build --release

# Stage 2: Runtime — minimal Debian
FROM debian:bookworm-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 vericto && \
    useradd --system --uid 1001 --gid vericto vericto

COPY --from=builder /app/target/release/vericto-proxy /usr/local/bin/vericto-proxy
RUN chown vericto:vericto /usr/local/bin/vericto-proxy

USER vericto

ENV PROXY_EVAL_PORT=5434
ENV RUST_LOG=info
ENV RUST_BACKTRACE=0

EXPOSE 5433
EXPOSE 5434

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS "http://localhost:${PROXY_EVAL_PORT}/health" || exit 1

CMD ["/usr/local/bin/vericto-proxy"]
