# =============================================================================
# vericto-proxy — LOCAL BUILD Dockerfile
#
# Resolves vericto-engine from the LOCAL workspace instead of a published git tag,
# so you can test local engine changes without cutting a release.
#
# Differs from the production Dockerfile only in how vericto-engine is resolved:
#   - Production (Dockerfile):  git = "https://github.com/.../vericto-engine", tag = "vX.Y.Z"
#   - Local (this file):        path override, engine passed as a BuildKit
#                               named build context (no copy into the repo)
#
# Build from vericto-proxy/ with the engine wired as a named context:
#
#   docker build \
#     -f Dockerfile.local \
#     -t vericto/proxy:local \
#     --build-context engine=../vericto-engine \
#     .
#
# Or use the helper script: ../scripts/build-local.sh
# =============================================================================

FROM rust:1.88-slim-bookworm AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libclang-dev \
    clang \
    libssl-dev \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ENV LIBCLANG_PATH=/usr/lib/llvm-14/lib

# Copy vericto-engine source (passed as a named build context: --build-context engine=../vericto-engine)
COPY --from=engine . /vericto-engine

# Copy vericto-proxy source.
COPY Cargo.toml ./
COPY src ./src

# Override the git dependency with the local path copy.
#
# The org, not `donkan168`: this sed matched the pre-transfer URL, and `sed` exits 0
# when its pattern misses, so the override silently did nothing and the build fell
# through to fetching the private repo — failing with "failed to authenticate" on a
# Dockerfile whose entire purpose is to build WITHOUT credentials.
#
# The pattern is deliberately loose about the owner so a future transfer degrades to
# a loud failure instead of a silent one: the grep below asserts the rewrite landed.
RUN sed -i -E 's|vericto-engine = \{ git = "https://github.com/[^"]+/vericto-engine".*\}|vericto-engine = { path = "/vericto-engine" }|' Cargo.toml \
    && grep -q 'path = "/vericto-engine"' Cargo.toml

# Build.
RUN cargo build --release

# Stage 2: Runtime — minimal Debian
FROM debian:bookworm-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 vericto && \
    useradd --system --uid 1001 --gid vericto vericto

COPY --from=builder /app/target/release/vericto-proxy /usr/local/bin/vericto-proxy
RUN chown vericto:vericto /usr/local/bin/vericto-proxy

USER vericto

# `PROXY_EVAL_PORT` and `EXPOSE 5434` date from when evaluation was an HTTP call to a
# sidecar. The engine runs in-process now and the variable is not read anywhere in the
# source, so the image no longer advertises a port it does not serve.
ENV RUST_LOG=info
ENV RUST_BACKTRACE=0

EXPOSE 5433

# The health listener is plain TCP: it accepts a connection and closes it without
# exchanging any bytes (src/tcp/healthz.rs), and it binds `VERICTO_HEALTHZ_PORT`. So the
# probe is a TCP connect rather than an HTTP GET.
#
# Both deployments already check it this way and do not rely on this directive:
# docker-compose.yml defines its own TCP check, and on ECS the verdict comes from the
# NLB target group with `HealthCheckProtocol: TCP`. Matching them here keeps the image
# usable on its own, which is what `docker run` and `docker ps` report against.
#
# The listener is opt-in, so with `VERICTO_HEALTHZ_PORT` unset there is nothing to
# probe and the container reports healthy: the absence of an optional port is not a
# failure. Using bash's `exec 3<>` keeps the runtime image free of curl.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD bash -c 'if [ -z "${VERICTO_HEALTHZ_PORT:-}" ]; then exit 0; fi; \
        exec 3<>/dev/tcp/127.0.0.1/"${VERICTO_HEALTHZ_PORT}" && exec 3<&- && exec 3>&-' || exit 1

CMD ["/usr/local/bin/vericto-proxy"]
