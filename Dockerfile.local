# =============================================================================
# vetro-proxy — LOCAL BUILD Dockerfile
#
# Resolves vetro-engine from the LOCAL workspace instead of a published git tag,
# so you can test local engine changes without cutting a release.
#
# Differs from the production Dockerfile only in how vetro-engine is resolved:
#   - Production (Dockerfile):  git = "https://github.com/.../vetro-engine", tag = "vX.Y.Z"
#   - Local (this file):        path override, engine passed as a BuildKit
#                               named build context (no copy into the repo)
#
# Build from vetro-proxy/ with the engine wired as a named context:
#
#   docker build \
#     -f Dockerfile.local \
#     -t vetro/proxy:local \
#     --build-context engine=../vetro-engine \
#     .
#
# Or use the helper script: ../scripts/build-local.sh
# =============================================================================

FROM rust:1.88-slim-bookworm AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libclang-dev \
    clang \
    libssl-dev \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ENV LIBCLANG_PATH=/usr/lib/llvm-14/lib

# Copy vetro-engine source (passed as a named build context: --build-context engine=../vetro-engine)
COPY --from=engine . /vetro-engine

# Copy vetro-proxy source.
COPY Cargo.toml ./
COPY src ./src

# Override the git dependency with the local path copy.
RUN sed -i 's|vetro-engine = { git = "https://github.com/donkan168/vetro-engine".*}|vetro-engine = { path = "/vetro-engine" }|' Cargo.toml

# Build.
RUN cargo build --release

# Stage 2: Runtime — minimal Debian
FROM debian:bookworm-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 vetro && \
    useradd --system --uid 1001 --gid vetro vetro

COPY --from=builder /app/target/release/vetro-proxy /usr/local/bin/vetro-proxy
RUN chown vetro:vetro /usr/local/bin/vetro-proxy

USER vetro

ENV PROXY_EVAL_PORT=5434
ENV RUST_LOG=info
ENV RUST_BACKTRACE=0

EXPOSE 5433
EXPOSE 5434

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS "http://localhost:${PROXY_EVAL_PORT}/health" || exit 1

CMD ["/usr/local/bin/vetro-proxy"]
