# =============================================================================
# vericto-proxy — environment configuration
# Copy to .env and adjust. UPSTREAM_HOST is required; everything else is
# optional with sensible defaults.
# =============================================================================

# ── Upstream database (required) ────────────────────────────────────────────
# The real database the proxy forwards safe queries to. The proxy exits at
# startup when UPSTREAM_HOST is unset.
UPSTREAM_HOST=postgres
UPSTREAM_PORT=5432
# Port where the proxy listens for client connections.
PROXY_LISTEN_PORT=5433
# Wire protocol: "postgres" (default) or "mysql". It also picks the default
# ports when the two above are unset (Postgres 5432/5433, MySQL 3306/3307).
# VERICTO_WIRE_PROTOCOL=postgres
# Database id this proxy fronts, used to tag telemetry (optional).
# VERICTO_DATABASE_ID=

# ── Upstream TLS (proxy → database hop) ─────────────────────────────────────
# Encrypts the connection between the proxy and your database. Recommended when
# the database is remote (e.g. a managed RDS instance). It does not cover the
# app→proxy hop; see Client TLS below.
#   disable      → plaintext (default; trusted-network deployment)
#   require      → encrypt, do not verify the server certificate
#   verify-ca    → encrypt and verify the certificate chain against
#                  UPSTREAM_SSLROOTCERT (required), not the hostname
#   verify-full  → encrypt and verify the certificate chain + hostname
# Any case. Any other value (including libpq's prefer/allow, which can fall
# back to plaintext) stops the proxy at startup.
# UPSTREAM_SSLMODE=disable
# CA bundle (PEM) used to verify the upstream certificate in verify-ca and
# verify-full modes, on Postgres and MySQL. With verify-full, omit it to use
# the bundled public CA roots (webpki-roots).
# UPSTREAM_SSLROOTCERT=/etc/vericto/rds-ca.pem
# Mutual TLS to the database (optional): present a client certificate so the
# proxy authenticates to the DB via the `cert` method, as a single service
# identity. Both must be set together; only used when UPSTREAM_SSLMODE is
# require/verify-ca/verify-full, on Postgres and MySQL.
# UPSTREAM_SSLCERT=/etc/vericto/proxy-client.crt
# UPSTREAM_SSLKEY=/etc/vericto/proxy-client.key

# ── Client TLS (app → proxy hop, optional) ──────────────────────────────────
# By default the proxy declines client TLS and assumes it runs inside the same
# trusted boundary as your app (sidecar / private subnet). Enable this only when
# the app→proxy hop crosses an untrusted network, or your driver enforces
# sslmode=require and you cannot put a TLS-terminating load balancer in front.
#   disable  → decline client TLS (default)
#   require  → terminate TLS as the server (needs PROXY_TLS_CERT + PROXY_TLS_KEY)
# Any case. Any other value stops the proxy at startup.
# Server-side TLS only (the client authenticates the proxy). Not supported
# through TLS termination: SCRAM channel binding (SCRAM-SHA-256-PLUS) and DB
# `cert` auth tied to the end client. scram-sha-256, md5 and token auth work.
# PROXY_TLS_MODE=disable
# Each accepts EITHER a path to a PEM file OR the PEM contents inline (anything
# starting with "-----BEGIN" is treated as inline). Inline is the shape that lets a
# secrets manager supply the key: ECS, Kubernetes and most orchestrators inject
# secrets as environment variables, not files, so a path-only contract forces the
# private key into the container image — readable by anyone who can pull it, kept in
# the layer history, and rotatable only by rebuilding.
# PROXY_TLS_CERT=/etc/vericto/server.crt
# PROXY_TLS_KEY=/etc/vericto/server.key

# ── Control-plane link (optional) ───────────────────────────────────────────
# When set, the proxy reports evaluations to the Vericto API and pulls its
# ruleset from it. If unset, the proxy uses its local default ruleset.
# VERICTO_API_URL=https://api.vericto.com
# VERICTO_API_KEY=
# How often to poll GET /sync/rules (seconds). Default: 300.
# VERICTO_RULES_SYNC_INTERVAL_SECS=300
# Telemetry buffering: "memory" (default) or "disk".
# VERICTO_TELEMETRY_BUFFER=memory
# VERICTO_TELEMETRY_DISK_PATH=/var/lib/vericto/spool
# Last-good ruleset, so a restart during a control-plane outage keeps the
# workspace's rules. Default: <spool dir>/.rules-cache with the disk buffer,
# off with memory. Empty = off.
# VERICTO_RULES_CACHE_PATH=
# VERICTO_TELEMETRY_MEMORY_CAPACITY=10000
# VERICTO_TELEMETRY_BATCH_SIZE=100
# VERICTO_TELEMETRY_FLUSH_SECS=5
# Disk buffer only: events queued in memory for the spool writer (past it new
# events are dropped and counted; queries never wait), how long an event may
# wait before its batch is written and fsynced, and events per spool file.
# VERICTO_TELEMETRY_QUEUE_CAPACITY=2048
# VERICTO_TELEMETRY_SPOOL_FLUSH_MS=50
# VERICTO_TELEMETRY_SPOOL_BATCH_MAX=1000
# Disk buffer only: most bytes of spool files (default 1 GiB, ~28 min of an API
# outage at 1,500 events/s; see docs/CONFIGURATION.md "Disk spool size") and an
# optional event bound on top of it (unset: VERICTO_TELEMETRY_MEMORY_CAPACITY if
# set, else none).
# VERICTO_TELEMETRY_SPOOL_MAX_BYTES=1073741824
# VERICTO_TELEMETRY_SPOOL_MAX_EVENTS=
# On SIGTERM/SIGINT: time to write queued events and deliver what it can.
# VERICTO_TELEMETRY_SHUTDOWN_TIMEOUT_MS=5000
# Disk buffer only, for several proxies mounting one volume at the same path:
# each spools to <disk path>/tasks/<name>/ ("task" = ECS task id, else hostname;
# "hostname"; or a fixed name) and adopts the directories of proxies gone for
# VERICTO_TELEMETRY_SPOOL_ORPHAN_SECS (default 600, min 120). Off when unset.
# VERICTO_TELEMETRY_SPOOL_SUBDIR=task
# VERICTO_TELEMETRY_SPOOL_ORPHAN_SECS=600

# ── Query size limit ────────────────────────────────────────────────────────
# Largest statement the proxy evaluates, in bytes. A larger one is refused
# before parsing (forwarded unevaluated in monitor_mode). Default: 10 MiB.
# VERICTO_MAX_QUERY_BYTES=10485760

# ── Health check (optional) ─────────────────────────────────────────────────
# Dedicated TCP port for load-balancer probes. It accepts and closes each
# connection, never contacts the database, and opens only after warm-up.
# Off when unset.
# VERICTO_HEALTHZ_PORT=8081
# Address it binds. Default 0.0.0.0. Keep it private: never internet-facing.
# VERICTO_HEALTHZ_ADDR=0.0.0.0

# ── Metrics (optional) ──────────────────────────────────────────────────────
# GET /metrics (Prometheus text) on the healthz listener only. Default off.
# VERICTO_METRICS_PROMETHEUS=false
# CloudWatch Embedded Metric Format: one JSON line on stdout per interval.
# VERICTO_METRICS_EMF=false
# VERICTO_METRICS_EMF_NAMESPACE=Vericto/Proxy
# VERICTO_METRICS_EMF_INTERVAL_SECS=60
# VERICTO_METRICS_PROXY_NAME=vericto-proxy
# VERICTO_METRICS_EMF_TASK_DIMENSION=true

# ── Logging ─────────────────────────────────────────────────────────────────
# tracing-subscriber EnvFilter directive.
RUST_LOG=info,vericto_proxy=debug
RUST_BACKTRACE=0
